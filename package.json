{
  "name": "agent-helper",
  "version": "0.6.3",
  "description": "Local Codex/ZCode usage monitor and task scheduler",
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --mac"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.agent.helper",
    "productName": "Agent Helper",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "electron/assets/AppIcon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "codex_model_watch.py",
      "watch_scheduler.py",
      "README*",
      "LICENSE",
      "package.json"
    ],
    "asarUnpack": [
      "codex_model_watch.py",
      "watch_scheduler.py",
      "web/**/*",
      "electron/assets/tray-icon.png"
    ]
  }
}
