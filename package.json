{
  "name": "agent-helper",
  "version": "0.5.2",
  "description": "Local Codex/ZCode usage monitor and task scheduler",
  "author": {
    "name": "Allen Cheng",
    "email": "allenchengx@gmail.com"
  },
  "main": "electron/main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron .",
    "dist": "electron-builder --mac",
    "dist:linux": "electron-builder --linux"
  },
  "devDependencies": {
    "electron": "^38.1.0",
    "electron-builder": "^26.0.12"
  },
  "build": {
    "appId": "local.agent.helper",
    "productName": "Agent Helper",
    "mac": {
      "category": "public.app-category.utilities",
      "icon": "electron/assets/AppIcon.icns",
      "target": [
        "dmg",
        "zip"
      ]
    },
    "linux": {
      "category": "Utility",
      "icon": "electron/assets/app-icon.png",
      "target": [
        "AppImage",
        "deb"
      ]
    },
    "files": [
      "electron/**/*",
      "web/**/*",
      "agent_helper.py",
      "watch_scheduler.py",
      "README*",
      "LICENSE",
      "package.json"
    ],
    "asarUnpack": [
      "agent_helper.py",
      "watch_scheduler.py",
      "web/**/*",
      "electron/assets/tray-icon.png"
    ]
  }
}
